[Unit]
Description=TimeLens Internal frame receiver
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=timelens-frame
Group=timelens-frame
EnvironmentFile=/etc/timelens-frame/server.env
WorkingDirectory=/opt/timelens-frame
ExecStart=/opt/timelens-frame/.venv/bin/uvicorn timelens_upload.app:create_app --factory --host 127.0.0.1 --port 8791 --workers 1
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/timelens-frame
[Install]
WantedBy=multi-user.target
