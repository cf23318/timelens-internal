[Unit]
Description=TimeLens archive expiry and orphan cleanup
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=timelens-frame
Group=timelens-frame
EnvironmentFile=/etc/timelens-frame/server.env
ExecStart=/opt/timelens-frame/.venv/bin/timelens-archive retention-daemon
Restart=always
RestartSec=10
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/timelens-frame
[Install]
WantedBy=multi-user.target
