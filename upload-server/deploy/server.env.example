# OSS destination retained from the supplied package; this template does not activate uploads.
TIMELENS_SPOOL_DIR=/var/lib/timelens-frame
TIMELENS_DEVICE_TOKENS_FILE=/etc/timelens-frame/device-tokens.json
TIMELENS_OSS_BUCKET=umall-video-record
TIMELENS_OSS_ENDPOINT=https://oss-cn-beijing-internal.aliyuncs.com
# OSS_ACCESS_KEY_ID and OSS_ACCESS_KEY_SECRET belong only to this server.
# The internal endpoint is for Beijing-region Alibaba Cloud hosts.
# Outside that network, use https://oss-cn-beijing.aliyuncs.com instead.
# Effective device tokens and OSS credentials must be provisioned separately.
