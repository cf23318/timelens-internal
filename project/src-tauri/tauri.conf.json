{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TimeLens Internal",
  "version": "0.17.5",
  "identifier": "com.timelens.internal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TimeLens",
        "width": 1120,
        "height": 720,
        "resizable": true,
        "transparent": false,
        "decorations": true,
        "shadow": false,
        "additionalBrowserArgs": "--disable-features=CalculateNativeWinOcclusion --disable-renderer-backgrounding"
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset: timelens: http://asset.localhost http://timelens.localhost; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob: asset: timelens: http://asset.localhost http://timelens.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src 'none'; object-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/.timelens-internal/**", "$USERPROFILE/.timelens-internal/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "./Entitlements.plist",
      "signingIdentity": null
    }
  }
}
